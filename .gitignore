# Nexus repo root -- see web-app/.gitignore for the app's own ignores
# (node_modules, .next/, etc. -- those apply relative to web-app/ already).

# Personal data: conversation logs, keys, per-machine settings.
# Created by install.ps1, seeded from web-app/defaults/local_data.
/local_data/

# voicechanger runtime state -- both files are opened in append mode by the
# Python scripts that write them, so they're created automatically on first
# run if missing. See voicechanger/README.md and web-app/scripts/README.md.
/voicechanger/kohai.txt
/voicechanger/ear_log.txt
/voicechanger/*_backup/

# Python artifacts (voicechanger/)
__pycache__/
*.pyc
.venv/
venv/

# misc
.DS_Store
*.pem
