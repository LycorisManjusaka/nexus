# Nexus repo root -- see web-app/.gitignore for the app's own ignores
# (node_modules, .next/, etc. -- those apply relative to web-app/ already).

# Personal data: conversation logs, keys, per-machine settings.
# Created by install.ps1, seeded from web-app/defaults/local_data.
/local_data/

# voicechanger runtime state (chara_settings.json, device_settings.json,
# quirks.json, speakers.json, gairaigo.txt, kohai.txt, ear_log.txt, and their
# *_backup/ snapshot folders) now lives under local_data/voicechanger/ --
# already covered by the /local_data/ rule above. voicechanger/ itself holds
# only git-tracked program code + notification .wav assets.

# Python artifacts (voicechanger/)
__pycache__/
*.pyc
.venv/
venv/

# misc
.DS_Store
*.pem
