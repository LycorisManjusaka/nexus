# Normalize line endings to LF in the repository, check out native on each OS.
# Prevents spurious whole-file diffs when syncing across machines (desktop/laptop/work).
* text=auto eol=lf

# Treat known binary types as binary (never line-ending munged).
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
